# .gitignore
old/*.svg
scratch
logs
docs

# Build output
/bin/

# Local workspaces for co-developing ds4go
/go.work
/go.work.sum

# Stray binaries built into the repo root
/ds4go-toy-cadpad
/ds4go-toy-glyphpad
/ds4go-toy-svgpad
/ds4go-playground
/cadpad
/glyphpad
/svgpad
/trippad
/trippad-gallery/

# ds4 shared libraries dropped into lib/ (lib/README.md is kept)
/lib/libds4.*
*.so
*.dylib
*.dll

# Model weights
*.gguf

# SVG in root
/*.svg

# Mesh exports in root
/*.stl
/*.3mf

# Local SSH keys (NEVER commit private keys)
/id_ed25519
/id_ed25519.pub

# cadpad GPU spike dump (regenerated with DUMP_PNG=1)
/internal/cadpad/render/testdata/spike_*.png

# cadpad session + tool/runtime artifacts
/cadpad-session.cad.json

# Presets and scenes saved into the repo root by running the pads there
# (committed examples live under examples/)
/*.trip.json
/*.cad.json
/users.json
/.antigravitycli/

# Go test/coverage artifacts
*.log
*.test
*.out
coverage.txt

# Local agent tooling state and generated plans
.claude/
.superpowers/
docs/superpowers/

# Editor and OS noise
.task
.DS_Store
.*.swp
*~
